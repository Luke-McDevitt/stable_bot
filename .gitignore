__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
install/
log/
.pytest_cache/
stewart_bringup/logs/
.DS_Store
Thumbs.db
.vscode/
*.swp

# Generated camera calibration (see oak_intrinsics.yaml.template).
# Each user runs `calibrate_oak.py --stage factory` (and Stage C from
# the GUI) on their own hardware; the rendered files don't belong in git.
stewart_vision/config/oak_intrinsics.yaml
stewart_vision/config/oak_extrinsics.yaml

# Vision-debug bags: only the digest artifacts (digest.png +
# digest.summary.json) are committed. The raw rosbag2 mcap is tens
# of MB once RGB and the depth-blob debug overlay are flowing —
# too large to ship per-bag. gui_server's push button forces the
# digest files in with `git add -f`.
tuning_data/*_vision_debug/*.mcap
tuning_data/*_vision_debug/metadata.yaml

# Demo-run bags (Demos 1, 2, 3 tuning runs). Same policy as
# vision_debug: digest only, raw mcap stays on the Pi.
tuning_data/*_demo1/*.mcap
tuning_data/*_demo1/metadata.yaml
tuning_data/*_demo2/*.mcap
tuning_data/*_demo2/metadata.yaml
tuning_data/*_demo3/*.mcap
tuning_data/*_demo3/metadata.yaml
tuning_data/*_demo_run/*.mcap
tuning_data/*_demo_run/metadata.yaml
tuning_data/*_demo_untagged/*.mcap
tuning_data/*_demo_untagged/metadata.yaml

# Auto-tune session bags: the per-trial mcap is for offline replay
# only and routinely exceeds GitHub's 100 MB single-file limit. The
# digest (fitness_curve.png + gain_trajectory.png + target_coverage.png
# + digest.summary.json + log.jsonl + summary.json) is the highlights
# reel that DOES get committed.
tuning_data/auto_tune_*/bag/
tuning_data/auto_tune_*/bag/*.mcap
tuning_data/auto_tune_*/bag/metadata.yaml

# YOLO V1 training intermediates: extracted frames (JPEG dumps from
# vision-debug bags) get uploaded to Roboflow for labeling. The
# labeled output is committed under training_data/v1_yolov6/, which
# IS what trained models are reproducible from. Raw JPEGs are
# transient and don't belong in git.
training_data/v1/

# Fitter report sidecar — regenerable, written next to ball_model.yaml. Only
# the .yaml is pushed (via the GUI Push button); the .fit.json stays local and
# must not trip pi_deploy.sh's source-change gate.
stewart_bringup/config/*.fit.json
