[Unit]
Description=Stable-Bot ROS 2 stack (Xsens IMUs + control node + rosbridge)
After=network-online.target stable_bot_gui.service
Wants=network-online.target

[Service]
Type=simple
User=sorak
Group=sorak
WorkingDirectory=/home/sorak/ros2_ws
Environment=HOME=/home/sorak
# OAK_USB_SPEED=super: requires usb_max_current_enable=1 in
# /boot/firmware/config.txt (Pi 5 default 600 mA cap → 1.2 A) AND a
# Pi 5 PSU sized for ~1.2 A USB load. If the OAK starts crashing
# again with X_LINK_ERROR, set this to 'high' (USB 2.0) to halve
# its draw — the bandwidth fits comfortably in USB2.
Environment=OAK_USB_SPEED=super
# Depth subsystem (StereoDepth + mono right + IR projector + SLC) is
# explicitly OFF. Mono is no longer used for ArUco (RGB has the IR-cut
# filter, so platform_pose subscribes to /oak/rgb/image_compressed),
# and the depth-blob detector was only ever a backup to V0 — turning
# it off frees ~30 MB/s of USB bandwidth so RGB can run at full 60 Hz
# for the lowest-latency V0 path.
Environment=OAK_ENABLE_DEPTH=0
# Skip the V0.5c color-filter NN entirely so V1 YOLO has the full
# Myriad X SHAVE budget. V0.5c was a dead end (NaN output, wrong
# detection ceiling); kept in code for git-history fallback only.
Environment=OAK_DISABLE_V0_NN=1
# Boot-time default detector. cv2 (HSV+contour, host-side) is the
# operator's preferred default for closed-loop demos as of
# 2026-05-02 — it's empirically more reliable for the demo's motion
# profile despite v1_yolo's edge in static benchmarks. Runtime-
# switchable via /oak/cmd_v0_backend topic + GUI selector; this
# just sets what's running at boot.
Environment=OAK_V0_BACKEND=cv2
# Pipeline performance knobs.
#   OAK_ENABLE_MONO=0  — mono unused (ArUco runs on RGB), saves USB.
#   OAK_DISABLE_JPEG=0 — keep JPEG ON; the encoder ate Myriad X
#                        cycles at 60 fps (capped V1 YOLO at 22 Hz)
#                        but we now throttle it via a Script node.
#   OAK_JPEG_FPS=10    — Script-node throttle: cam_rgb runs at 60 fps
#                        for V1 NN, but only every 6th frame reaches
#                        the encoder. JPEG-via-encoder Myriad X cost
#                        drops 6×, V1 YOLO holds at 60 Hz, GUI live
#                        preview + platform_pose still get a useful
#                        10 fps stream. Set to 0 to disable throttle
#                        (full 60 fps JPEG, V1 drops to ~22 Hz).
Environment=OAK_ENABLE_MONO=0
Environment=OAK_DISABLE_JPEG=0
Environment=OAK_JPEG_FPS=10
# Force V1 architecture (overrides auto-detect: prefer v6, fall back to v8).
#   v6 = YOLOv6n (Meituan, ~60 Hz solo benchmark)
#   v8 = YOLOv8n (Ultralytics, ~30 Hz solo benchmark, slightly higher mAP)
# Operator A/B'd 2026-05-01 — v8 produced ~20% cleaner detection on
# the foam ball under motion blur. Locked in here as the default;
# comment this line and the auto-detect picks v6 first again.
Environment=OAK_FORCE_V1_ARCH=v8
# Mono FPS stays at 15 (default). 2026-05-01: tried OAK_MONO_FPS=60
# to test the hypothesis that mono rate gates RGB; at 60 fps mono,
# platform_pose_node's ArUco solve was dropping out (pose=0 in
# /oak/health), which broke cv2's platform mask and made the cv2
# fallback detector unusable. The real RGB throttling fix was
# elsewhere (XLinkOut/ImageManip non-blocking + cv2 skip when YOLO
# is the active backend).
ExecStart=/bin/bash -c 'source /opt/ros/kilted/setup.bash && \
                        source /home/sorak/ros2_ws/install/local_setup.bash && \
                        exec ros2 launch stewart_bringup stewart_gui_launch.py'
Restart=on-failure
RestartSec=3
# Flush stdout/stderr to journald — no in-memory buffering.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
