[Unit]
Description=Stable-Bot ROS 2 stack (Xsens IMUs + control node + rosbridge)
After=network-online.target stable_bot_gui.service
Wants=network-online.target

[Service]
Type=simple
User=sorak
Group=sorak
WorkingDirectory=/home/sorak/ros2_ws
Environment=HOME=/home/sorak
# OAK_USB_SPEED=super: requires usb_max_current_enable=1 in
# /boot/firmware/config.txt (Pi 5 default 600 mA cap → 1.2 A) AND a
# Pi 5 PSU sized for ~1.2 A USB load. If the OAK starts crashing
# again with X_LINK_ERROR, set this to 'high' (USB 2.0) to halve
# its draw — the bandwidth fits comfortably in USB2.
Environment=OAK_USB_SPEED=super
# Depth subsystem (StereoDepth + mono right + IR projector + SLC) is
# explicitly OFF. Mono is no longer used for ArUco (RGB has the IR-cut
# filter, so platform_pose subscribes to /oak/rgb/image_compressed),
# and the depth-blob detector was only ever a backup to V0 — turning
# it off frees ~30 MB/s of USB bandwidth so RGB can run at full 60 Hz
# for the lowest-latency V0 path.
Environment=OAK_ENABLE_DEPTH=0
# Skip the V0.5c color-filter NN entirely so V1 YOLO has the full
# Myriad X SHAVE budget. V0.5c was a dead end (NaN output, wrong
# detection ceiling); kept in code for git-history fallback only.
Environment=OAK_DISABLE_V0_NN=1
# Bump mono FPS to 60 to test whether the OAK firmware ties RGB
# sensor rate to the slowest sensor in the pipeline. With mono at
# 15 fps, observed RGB throttled to ~14 fps despite cam_rgb being
# configured at 60 — known OAK quirk. If RGB rate jumps after
# this, the hypothesis is confirmed; if not, the bottleneck is
# elsewhere (NN compute / blob structure).
Environment=OAK_MONO_FPS=60
ExecStart=/bin/bash -c 'source /opt/ros/kilted/setup.bash && \
                        source /home/sorak/ros2_ws/install/local_setup.bash && \
                        exec ros2 launch stewart_bringup stewart_gui_launch.py'
Restart=on-failure
RestartSec=3
# Flush stdout/stderr to journald — no in-memory buffering.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
